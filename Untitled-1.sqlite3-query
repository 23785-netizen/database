-- All cars
SELECT * FROM Cars;
-- all cars and the maker
SELECT Makers.Name,Cars.Model FROM Cars
JOIN Makers ON Makers.MakerID = Cars.MakerID;

--Cars of one make
SELECT Cars.Model FROM Cars
JOIN Makers ON Makers.MakerID = Cars.MakerID
WHERE Makers.Name = "Benz";

--just id, model, maker and imageurl
SELECT Cars.CarID,Makers.Name,Cars.Model,Cars.ImageURL 
FROM Cars
JOIN Makers ON Makers.MakerID = Cars.MakerID;

--just one car based on the id
SELECT * FROM Cars
JOIN Makers ON Makers.MakerID = Cars.MakerID
WHERE Cars.CarID = 2;